# Hybrid Gateway environment file. Copy to .env (gitignored) and fill in:
#   cp .env.example .env && chmod 600 .env
# Read once when `uv run gateway.py serve` starts. Values saved in the dashboard's
# Settings drawer override anything here; leave a drawer field empty to fall back
# to this file. Blank values count as unset. Relative paths resolve against this
# project folder, so the whole folder can be moved.

# --- Mac (local server) ---
# Any OpenAI-compatible server: oMLX on :8006, llama-server on :8080, Hermes's managed llama-server on :18434.
HYBRID_GATEWAY_LOCAL_URL=http://127.0.0.1:8080/v1
# The model /auto runs on the Mac (see Settings or `curl <local url>/models`).
HYBRID_GATEWAY_LOCAL_MODEL=
HYBRID_GATEWAY_ROUTER_MODEL=gemma-4-e2b-it-4bit
HYBRID_GATEWAY_ROUTER_TIMEOUT=8
HYBRID_GATEWAY_LOCAL_CONTEXT=64000
# Local server API key, if it needs one (or save it in Settings, which uses the Keychain).
HYBRID_GATEWAY_LOCAL_API_KEY=

# --- Telnyx ---
HYBRID_GATEWAY_REMOTE_URL=https://api.telnyx.com/v2/ai/openai
HYBRID_GATEWAY_FLASH_MODEL=zai-org/GLM-5.3-Flash
HYBRID_GATEWAY_K3_MODEL=moonshotai/Kimi-K3
HYBRID_GATEWAY_FLASH_CONTEXT=200000
# Telnyx key. Safer in the Keychain via Settings than in this plain-text file.
TELNYX_API_KEY=

# --- Proxy ---
# Shared secret Hermes sends to /telnyx and /auto. Must match HYBRID_GATEWAY_TOKEN in ~/.hermes/.env.
# Generate one with: openssl rand -hex 24   (or press Create token in Settings)
HYBRID_GATEWAY_TOKEN=
HYBRID_GATEWAY_READ_TIMEOUT=900

# --- Startup only (restart to change) ---
# HYBRID_GATEWAY_PORT=8787
# HYBRID_GATEWAY_DB=gateway.db
# HYBRID_GATEWAY_PRICES=prices.json
# HYBRID_GATEWAY_SETTINGS=settings.json
# HYBRID_GATEWAY_KEYCHAIN_SERVICE=hybrid-gateway
